# Use a dedicated provider URL for a production rollout.
# Copy to .dev.vars locally; configure ROBINHOOD_RPC_URL as a secret on the host.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Leave the vault unconfigured until its deployment and exact runtime are verified.
DESK_VAULT_ADDRESS=
DESK_VAULT_CODE_HASH=
DESK_VAULT_DEPLOY_BLOCK=0
# Public read-only report endpoint of the separately hosted private keeper.
# No signing keys belong in this dapp's configuration.
REWARDS_REPORT_URL=
