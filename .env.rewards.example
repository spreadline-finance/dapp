# Copy into your operator secret manager or an ignored local environment file.
# The launch runner generates exact address/code-hash/deployment-block values.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
REWARDS_DISTRIBUTOR_ADDRESS=
REWARDS_DISTRIBUTOR_CODE_HASH=
REWARDS_DEPLOY_BLOCK=0
REWARDS_TOKEN_DEPLOY_BLOCK=0
REWARDS_API_URL=https://your-spreadline-domain.example
REWARDS_STATE_DIR=.wrangler/rewards/production
REWARDS_CONFIRMATIONS=24
REWARDS_MAX_GAS_PER_TX=3000000
REWARDS_MAX_BATCHES=4
REWARDS_MIN_AUTO_PAYOUT_RAW=1
# Set your chosen spending cap before enabling --execute.
REWARDS_DAILY_GAS_BUDGET_ETH=0
# Secret: dedicated operator key; never NEXT_PUBLIC_ or a Worker variable.
REWARDS_OPERATOR_KEY=
# Optional additional exclusions need an explicit public reason; protocol inventory
# and burn addresses are already excluded automatically.
REWARDS_EXTRA_EXCLUSIONS=[]
